              "instance": "/labs/{owned}/publish"
            }
          }
        },
        {
          "type": "request",
          "tokenKind": "malformed",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "token-case-0002",
          "expected": {
            "status": 401,
            "body": {
              "type": "https://leetkob.example/problems/authentication-required",
              "title": "Authentication required",
              "status": 401,
              "detail": "Provide a valid, unexpired bearer token.",
              "instance": "/labs/{owned}/publish"
            }
          }
        },
        {
          "type": "request",
          "tokenKind": "tampered",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "token-case-0003",
          "expected": {
            "status": 401,
            "body": {
              "type": "https://leetkob.example/problems/authentication-required",
              "title": "Authentication required",
              "status": 401,
              "detail": "Provide a valid, unexpired bearer token.",
              "instance": "/labs/{owned}/publish"
            }
          }
        },
        {
          "type": "request",
          "tokenKind": "expired",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "token-case-0004",
          "expected": {
            "status": 401,
            "body": {
              "type": "https://leetkob.example/problems/authentication-required",
              "title": "Authentication required",
              "status": 401,
              "detail": "Provide a valid, unexpired bearer token.",
              "instance": "/labs/{owned}/publish"
            }
          }
        }
      ]
    },
