{
  "name": "leetkob",
  "version": "0.1.0",
  "private": true,
  "description": "LeeTKOB teaching-assistant lab review service",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev --workspace @leetkob/api",
    "dev:web": "npm run dev --workspace @leetkob/web",
    "compare:backends": "TSX_TSCONFIG_PATH=apps/api/tsconfig.json node --import tsx scripts/compare-backends.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --max-warnings=0 && node scripts/go-check.mjs vet",
    "format": "prettier --write .",
    "format:check": "prettier --check . && node scripts/go-check.mjs format",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run check:openapi-drift && node scripts/go-check.mjs build",
    "test": "node scripts/evaluation/sources.mjs verify evaluation/official && node --test scripts/evaluation/*.test.mjs && npm run test --workspaces --if-present && node scripts/go-check.mjs test",
    "security": "npm run security:secrets && npm audit --audit-level=high && node scripts/go-check.mjs security",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "check:openapi-drift": "node scripts/openapi-drift-check.mjs",
    "dev:local": "bash scripts/run-local.sh",
    "seed:local": "node scripts/e2e.mjs seed",
    "test:local": "node scripts/e2e.mjs smoke"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
