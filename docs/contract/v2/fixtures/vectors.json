      { "cpuTimeLimitMs": 1000, "memoryLimitBytes": 536870913, "valid": false },
      { "cpuTimeLimitMs": 1000, "memoryLimitBytes": 537919488, "valid": false },
      { "cpuTimeLimitMs": 1000, "memoryLimitBytes": 512000000, "valid": false }
    ]
  },
  "sourceSize": {
    "decision": ["D01"],
    "rule": "A source body has 1..65,536 bytes of valid UTF-8. The limit counts bytes, not characters.",
    "limitBytes": 65536,
    "cases": [
      { "bytes": 0, "outcome": "invalid-request" },
      { "bytes": 1, "outcome": "accepted" },
      { "bytes": 64000, "outcome": "accepted" },
      { "bytes": 65535, "outcome": "accepted" },
      { "bytes": 65536, "outcome": "accepted" },
      { "bytes": 65537, "outcome": "payload-too-large" },
      { "bytes": 1048576, "outcome": "payload-too-large" }
    ]
  },
  "outputSize": {
    "decision": ["D01"],
    "rule": "A test whose program writes more than 1,048,576 bytes to standard output is RE. Exactly 1,048,576 bytes is within the limit.",
    "limitBytes": 1048576,
    "cases": [
      { "bytes": 1000000, "withinLimit": true },
      { "bytes": 1048576, "withinLimit": true },
      { "bytes": 1048577, "withinLimit": false }
    ]
  },
  "submissionWindow": {
    "decision": ["D02"],
    "rule": "Accepted exactly when opensAt <= receivedAt < submissionDeadline. receivedAt is stamped when the complete bounded body has arrived. Before opensAt the lab is concealed from students.",
    "opensAt": "2026-11-20T02:00:00.000Z",
    "submissionDeadline": "2026-11-25T15:00:00.000Z",
    "cases": [
      { "receivedAt": "2026-11-20T01:59:59.999Z", "outcome": "lab-not-found" },
      { "receivedAt": "2026-11-20T02:00:00.000Z", "outcome": "accepted" },
      { "receivedAt": "2026-11-25T14:59:59.999Z", "outcome": "accepted" },
      { "receivedAt": "2026-11-25T15:00:00.000Z", "outcome": "submission-deadline-passed" },
      { "receivedAt": "2026-11-25T15:00:00.001Z", "outcome": "submission-deadline-passed" }
    ]
  },
  "countedSelection": {
    "decision": ["D02"],
    "rule": "The counted submission is the accepted one with the greatest (receivedAt, acceptanceSequence). Judge verdict, client time, and worker completion order never matter.",
    "cases": [
      {
        "id": "later-wrong-answer-counts",
        "submissions": [
          {
            "id": "A",
            "receivedAt": "2026-11-25T10:00:00.000Z",
            "acceptanceSequence": 10,
            "verdict": "AC",
            "judgedAt": "2026-11-25T10:00:05.000Z"
