{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leetkob.example/contract/messages/v1/messages.schema.json",
  "title": "LeeTKOB judge and checker message envelopes, major version 1",
  "description": "Draft for contract review (OpenSpec task 1.3). docs/contract/messages/README.md is the normative companion. This schema describes what a producer may emit; a consumer ignores unknown members inside a supported major version and rejects any other major version.",
  "oneOf": [
    { "$ref": "#/$defs/JudgeRequest" },
    { "$ref": "#/$defs/JudgeResult" },
    { "$ref": "#/$defs/CheckRequest" },
    { "$ref": "#/$defs/CheckResult" }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "description": "RFC 3339 UTC instant with exactly three fractional digits and the Z suffix.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Revision": { "type": "integer", "minimum": 1 },
    "MicroUsd": {
      "description": "Whole millionths of one US dollar.",
      "type": "integer",
      "minimum": 0
    },
    "Version": {
      "description": "MAJOR.MINOR of this envelope family. This schema covers major version 1.",
      "type": "string",
      "pattern": "^1\\.(?:0|[1-9][0-9]*)$"
    },
    "Job": {
      "description": "The durable job attempt this message belongs to. `attempt` is the fencing token: it increases every time the job is claimed, and only the highest issued attempt may commit a result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt", "leaseExpiresAt"],
      "properties": {
        "id": { "$ref": "#/$defs/Uuid" },
        "attempt": { "type": "integer", "minimum": 1 },
        "leaseExpiresAt": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "Subject": {
      "description": "The exact inputs the work was computed from. A result is current only while every member still equals the lab's active state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["labId", "submissionId", "gradingGeneration", "testRevision", "sourceSha256"],
      "properties": {
        "labId": { "$ref": "#/$defs/Uuid" },
        "submissionId": { "$ref": "#/$defs/Uuid" },
        "gradingGeneration": { "$ref": "#/$defs/Revision" },
        "testRevision": { "$ref": "#/$defs/Revision" },
        "sourceSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "Source": {
      "description": "The original submitted bytes. `bytes` is the decoded length.",
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "data", "bytes"],
      "properties": {
        "encoding": { "const": "base64" },
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "minLength": 4,
          "maxLength": 87384
        },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
      }
    },
    "ExecutionPolicy": {
      "description": "Identical to the HTTP ExecutionPolicy. All values use base units.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "compileProfile",
        "sourceLimitBytes",
        "compileTimeLimitMs",
        "cpuTimeLimitMs",
        "wallTimeLimitMs",
        "memoryLimitBytes",
        "processLimit",
        "outputLimitBytes"
      ],
      "properties": {
        "language": { "const": "cpp17" },
        "compileProfile": { "const": "gxx-std-cpp17-o2" },
        "sourceLimitBytes": { "const": 65536 },
        "compileTimeLimitMs": { "const": 10000 },
        "cpuTimeLimitMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 5000,
          "multipleOf": 1000
        },
        "wallTimeLimitMs": { "enum": [3000, 6000, 9000, 12000, 15000] },
        "memoryLimitBytes": {
          "type": "integer",
          "minimum": 67108864,
          "maximum": 536870912,
          "multipleOf": 1048576
        },
        "processLimit": { "const": 16 },
        "outputLimitBytes": { "const": 1048576 }
      }
    },
    "Executor": {
      "description": "Identifies the isolation backend and image that produced a judge result.",
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "imageDigest"],
      "properties": {
        "backend": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "Failure": {
      "description": "An infrastructure failure. It is never a student verdict and never an unsure finding.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "unsupported-version",
            "invalid-message",
            "input-digest-mismatch",
            "staging-failed",
            "sandbox-unavailable",
            "lease-expired",
            "internal"
          ]
        },
        "retryable": { "type": "boolean" }
      }
    },
    "EvidenceLine": {
      "description": "One original source line, 1-based. `text` is compared after trimming leading and trailing whitespace only.",
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "text"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "maxLength": 4096 }
      }
    },
    "ConstraintKey": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,31}$" },

    "JudgeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "messageId",
        "correlationId",
        "createdAt",
        "job",
        "subject",
        "payload"
      ],
      "properties": {
        "type": { "const": "leetkob.judge.request" },
        "version": { "$ref": "#/$defs/Version" },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "job": { "$ref": "#/$defs/Job" },
        "subject": { "$ref": "#/$defs/Subject" },
        "payload": {
          "description": "Everything the execution boundary receives. It carries no credential, account, class, or student identity.",
          "type": "object",
          "additionalProperties": false,
          "required": ["executionPolicy", "source", "testBundleSha256", "tests"],
          "properties": {
            "executionPolicy": { "$ref": "#/$defs/ExecutionPolicy" },
            "source": { "$ref": "#/$defs/Source" },
            "testBundleSha256": { "$ref": "#/$defs/Sha256" },
            "tests": {
              "description": "Stable test order. Test bytes are staged by digest, never embedded.",
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ordinal", "kind", "inputSha256", "expectedOutputSha256"],
                "properties": {
                  "ordinal": { "type": "integer", "minimum": 1 },
                  "kind": { "enum": ["sample", "hidden"] },
                  "inputSha256": { "$ref": "#/$defs/Sha256" },
                  "expectedOutputSha256": { "$ref": "#/$defs/Sha256" }
                }
              }
            }
          }
        }
      }
    },

    "JudgeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "messageId",
        "correlationId",
        "createdAt",
        "job",
        "subject",
        "payload"
      ],
      "properties": {
        "type": { "const": "leetkob.judge.result" },
        "version": { "$ref": "#/$defs/Version" },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "job": { "$ref": "#/$defs/Job" },
        "subject": { "$ref": "#/$defs/Subject" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/JudgeCompleted" },
            { "$ref": "#/$defs/JudgeInfrastructureFailure" }
          ]
        }
      }
    },
    "JudgeCompleted": {
      "description": "Aggregate verdict: CE when compilation fails or times out; otherwise the first non-AC test in stable order; otherwise AC.",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "verdict", "compile", "tests", "executor"],
      "properties": {
        "outcome": { "const": "completed" },
        "verdict": { "enum": ["AC", "WA", "TLE", "MLE", "RE", "CE"] },
        "compile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "message"],
          "properties": {
            "status": { "enum": ["ok", "error", "timeout"] },
            "message": {
              "description": "Compiler diagnostics truncated to 8,192 bytes; null when compilation succeeded.",
              "type": ["string", "null"],
              "maxLength": 8192
            }
          }
        },
        "tests": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "verdict", "cpuTimeMs", "wallTimeMs", "peakMemoryBytes"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 1 },
              "verdict": { "enum": ["AC", "WA", "TLE", "MLE", "RE"] },
              "cpuTimeMs": { "type": "integer", "minimum": 0 },
              "wallTimeMs": { "type": "integer", "minimum": 0 },
              "peakMemoryBytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "executor": { "$ref": "#/$defs/Executor" }
      },
      "if": {
        "properties": { "compile": { "properties": { "status": { "const": "ok" } } } }
      },
      "then": {
        "properties": {
          "verdict": { "enum": ["AC", "WA", "TLE", "MLE", "RE"] },
          "compile": { "properties": { "message": { "type": "null" } } },
          "tests": { "minItems": 1 }
        }
      },
      "else": {
        "properties": {
          "verdict": { "const": "CE" },
          "tests": { "maxItems": 0 }
        }
      }
    },
    "JudgeInfrastructureFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "failure"],
      "properties": {
        "outcome": { "const": "infrastructure-failure" },
        "failure": { "$ref": "#/$defs/Failure" },
        "executor": { "$ref": "#/$defs/Executor" }
      }
    },

    "CheckRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "messageId",
        "correlationId",
        "createdAt",
        "job",
        "subject",
        "payload"
      ],
      "properties": {
        "type": { "const": "leetkob.check.request" },
        "version": { "$ref": "#/$defs/Version" },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "job": { "$ref": "#/$defs/Job" },
        "subject": { "$ref": "#/$defs/Subject" },
        "payload": {
          "description": "Input of the checker core. It has no deduction amount, test content, account, or credential. Only the sanitized form of `source` may leave the checker.",
          "type": "object",
          "additionalProperties": false,
          "required": ["statementMarkdown", "constraints", "source", "redactionTerms"],
          "properties": {
            "statementMarkdown": { "type": "string", "maxLength": 262144 },
            "constraints": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "key", "revision", "text"],
                "properties": {
                  "id": { "$ref": "#/$defs/Uuid" },
                  "key": { "$ref": "#/$defs/ConstraintKey" },
                  "revision": { "$ref": "#/$defs/Revision" },
                  "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
                }
              }
            },
            "source": { "$ref": "#/$defs/Source" },
            "redactionTerms": {
              "description": "Known enrollment names and student codes that sanitization must remove from every outbound field. Never logged and never sent to a provider.",
              "type": "array",
              "maxItems": 400,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        }
      }
    },

    "CheckResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "version",
        "messageId",
        "correlationId",
        "createdAt",
        "job",
        "subject",
        "payload"
      ],
      "properties": {
        "type": { "const": "leetkob.check.result" },
        "version": { "$ref": "#/$defs/Version" },
        "messageId": { "$ref": "#/$defs/Uuid" },
        "correlationId": { "$ref": "#/$defs/Uuid" },
        "createdAt": { "$ref": "#/$defs/Timestamp" },
        "job": { "$ref": "#/$defs/Job" },
        "subject": { "$ref": "#/$defs/Subject" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/CheckCompleted" },
            { "$ref": "#/$defs/CheckInfrastructureFailure" }
          ]
        }
      }
    },
    "CheckCompleted": {
      "description": "Exactly one finding per requested constraint. Provider, schema, evidence, and budget problems are `unsure` findings with a cause, not failures.",
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "checker", "findings", "usage"],
      "properties": {
        "outcome": { "const": "completed" },
        "checker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkerVersion", "promptVersion", "modelId"],
          "properties": {
            "checkerVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
            "promptVersion": { "type": ["string", "null"], "maxLength": 64 },
            "modelId": { "type": ["string", "null"], "maxLength": 128 }
          }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/Finding" }
        },
        "usage": {
          "description": "`settledMicroUsd` is null while provider usage is unknown; the reservation then stays charged.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelCalls",
            "reservedMicroUsd",
            "settledMicroUsd",
            "inputTokens",
            "outputTokens"
          ],
          "properties": {
            "modelCalls": { "type": "integer", "minimum": 0, "maximum": 2 },
            "reservedMicroUsd": { "$ref": "#/$defs/MicroUsd" },
            "settledMicroUsd": {
              "oneOf": [{ "$ref": "#/$defs/MicroUsd" }, { "type": "null" }]
            },
            "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
            "outputTokens": { "type": ["integer", "null"], "minimum": 0 }
          }
        }
      }
    },
    "Finding": {
      "description": "A verdict with evidence. It has no grade, score, or deduction member.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraintId",
        "constraintKey",
        "constraintRevision",
        "source",
        "verdict",
        "reason",
        "evidence",
        "unsureCause"
      ],
      "properties": {
        "constraintId": { "$ref": "#/$defs/Uuid" },
        "constraintKey": { "$ref": "#/$defs/ConstraintKey" },
        "constraintRevision": { "$ref": "#/$defs/Revision" },
        "source": { "enum": ["deterministic", "model"] },
        "verdict": { "enum": ["pass", "violation", "unsure"] },
        "reason": { "type": ["string", "null"], "maxLength": 2000 },
        "evidence": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/EvidenceLine" }
        },
        "unsureCause": {
          "enum": [
            null,
            "preparation-failed",
            "unsupported-resolution",
            "schema-invalid",
            "evidence-mismatch",
            "provider-timeout",
            "provider-failure",
            "budget-exhausted",
            "pricing-unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "violation" } } },
          "then": {
            "properties": {
              "evidence": { "minItems": 1 },
              "unsureCause": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "pass" } } },
          "then": {
            "properties": {
              "evidence": { "maxItems": 0 },
              "unsureCause": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "verdict": { "const": "unsure" } } },
          "then": {
            "properties": {
              "unsureCause": { "type": "string" }
            }
          }
        }
      ]
    },
    "CheckInfrastructureFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "failure"],
      "properties": {
        "outcome": { "const": "infrastructure-failure" },
        "failure": { "$ref": "#/$defs/Failure" }
      }
    },

    "Prediction": {
      "description": "One line of the evaluation prediction file written by the checker command. The format is owned by the official evaluation contract (fithcmus/awad-leetkob-eval at commit 552c811db2d35a23d641bc4fdffc1ac120be1a28) and is reproduced here only so the CLI adapter can be validated. It is not an envelope and has no version member.",
      "type": "object",
      "additionalProperties": false,
      "required": ["solution", "constraint", "verdict", "evidence"],
      "properties": {
        "solution": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "constraint": { "type": "string", "minLength": 1 },
        "verdict": { "enum": ["pass", "violation", "unsure"] },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line", "text"],
            "properties": {
              "line": { "type": "integer", "minimum": 1 },
              "text": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
