  "evidence": {
    "decision": ["D09"],
    "rule": "Cited text matches the original line exactly after removing leading and trailing whitespace from both. Nothing else is normalized.",
    "cases": [
      {
        "originalLine": "    stable_sort(a.begin() + lo, a.begin() + hi);",
        "citedText": "stable_sort(a.begin() + lo, a.begin() + hi);",
        "matches": true
      },
      {
        "originalLine": "\tstd::sort(v.begin(), v.end());\r",
        "citedText": "  std::sort(v.begin(), v.end());  ",
        "matches": true
      },
      {
        "originalLine": "stable_sort(a.begin() + lo, a.begin() + hi);",
        "citedText": "stable_sort(a.begin()+lo, a.begin() + hi);",
        "matches": false
      },
      {
        "originalLine": "std::sort(v.begin(), v.end());",
        "citedText": "std::sort(v.begin(), v.end())",
        "matches": false
      },
      {
        "originalLine": "std::sort(v.begin(), v.end());",
        "citedText": "STD::SORT(v.begin(), v.end());",
        "matches": false
      },
      {
        "originalLine": "sort(a, a + n); // quick",
        "citedText": "sort(a, a + n);",
        "matches": false
      },
      { "originalLine": "x  =  1;", "citedText": "x = 1;", "matches": false },
      { "originalLine": "", "citedText": "   ", "matches": true }
    ]
  },
  "testBundleLimits": {
    "decision": ["D07"],
    "rule": "A bundle has at most 10,485,760 compressed bytes, 104,857,600 expanded bytes, and 1,000 entries. The compressed limit is a request-size limit; the other two are bundle-content limits.",
    "limits": { "compressedBytes": 10485760, "expandedBytes": 104857600, "entries": 1000 },
    "cases": [
      {
        "compressedBytes": 10485760,
        "expandedBytes": 104857600,
        "entries": 1000,
        "outcome": "accepted"
      },
      {
        "compressedBytes": 10485761,
        "expandedBytes": 1024,
        "entries": 2,
        "outcome": "payload-too-large"
      },
      {
        "compressedBytes": 2048,
        "expandedBytes": 104857601,
        "entries": 2,
        "outcome": "test-bundle-invalid",
        "violations": ["expanded-size-exceeded"]
      },
      {
        "compressedBytes": 2048,
        "expandedBytes": 4096,
        "entries": 1001,
        "outcome": "test-bundle-invalid",
        "violations": ["entry-limit-exceeded"]
      },
      {
        "compressedBytes": 2048,
        "expandedBytes": 104857601,
        "entries": 1001,
        "outcome": "test-bundle-invalid",
        "violations": ["entry-limit-exceeded", "expanded-size-exceeded"]
      }
    ]
  },
  "classCapacity": {
    "decision": ["D07"],
    "rule": "A class holds at most 100 students. TAs do not count toward the limit.",
    "capacity": 100,
    "cases": [
      { "studentsBefore": 0, "outcome": "enrolled", "studentsAfter": 1 },
      { "studentsBefore": 99, "outcome": "enrolled", "studentsAfter": 100 },
      { "studentsBefore": 100, "outcome": "class-capacity-reached", "studentsAfter": 100 }
    ]
  },
  "aggregateVerdict": {
    "decision": ["D04"],
    "rule": "CE when compilation fails or exceeds 10,000 ms; otherwise the first non-AC test in stable order; otherwise AC.",
    "cases": [
      { "compile": "ok", "tests": ["AC", "AC", "AC"], "verdict": "AC" },
      { "compile": "ok", "tests": ["AC", "WA", "TLE"], "verdict": "WA" },
      { "compile": "ok", "tests": ["TLE", "WA", "AC"], "verdict": "TLE" },
      { "compile": "ok", "tests": ["AC", "AC", "MLE"], "verdict": "MLE" },
      { "compile": "ok", "tests": ["RE"], "verdict": "RE" },
      { "compile": "error", "tests": [], "verdict": "CE" },
      { "compile": "timeout", "tests": [], "verdict": "CE" }
    ]
  },
  "constraintEdits": {
