          { "formulaGrade": "6.00", "manualAdjustmentAmount": "5.50", "grade": "10.00" }
        ]
      },
      {
        "id": "negative-adjustment-kept-after-accepted-appeal-then-replaced",
        "judgeVerdict": "AC",
        "deductions": [
          { "key": "C1", "amount": "3.00", "evidenceLines": 1 },
          { "key": "C2", "amount": "4.00", "evidenceLines": 1 }
        ],
        "steps": [
          { "op": "adjust", "targetGrade": "2.00" },
