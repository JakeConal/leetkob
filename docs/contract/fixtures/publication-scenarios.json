              "instance": "/labs/{owned}/publish",
              "labId": "{owned}",
              "publishedAt": "{instant}",
              "publishedBy": "ta-1"
            }
          }
        }
      ]
    },
    {
      "name": "concurrent-different-keys-result-in-one-publication",
      "labs": [
        {
          "id": "{owned}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{passed}"
        }
      ],
      "steps": [
        {
          "type": "concurrent",
          "requests": [
            {
              "identity": "ta",
              "method": "POST",
              "path": "/labs/{owned}/publish",
              "idempotencyKey": "concurrent-request-0001"
            },
            {
              "identity": "ta",
              "method": "POST",
              "path": "/labs/{owned}/publish",
              "idempotencyKey": "concurrent-request-0002"
            }
          ],
          "expectedStatuses": [200, 409]
        }
      ]
    },
    {
      "name": "persistence-failure-returns-generic-problem-without-mutation",
      "failLabSave": true,
      "labs": [
        {
          "id": "{owned}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{passed}"
        }
      ],
      "steps": [
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "failing-request-0001",
          "saveBodyAs": "body",
          "expected": {
            "status": 500,
            "body": {
              "type": "https://leetkob.example/problems/internal-error",
              "title": "Internal server error",
              "status": 500,
              "detail": "The request could not be completed.",
              "instance": "/labs/{owned}/publish"
            }
          }
        },
        { "type": "assertNotContains", "from": "body", "forbidden": ["password"] },
        { "type": "expectLab", "labId": "{owned}", "status": "ready" }
      ]
    },
    {
      "name": "success-and-problem-bodies-contain-no-protected-data",
      "labs": [
        {
          "id": "{owned}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{passed}"
        },
        {
          "id": "{pending}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 2,
          "submissionDeadline": "{passed}"
        }
      ],
      "steps": [
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "publish-request-0001",
          "saveBodyAs": "successBody"
        },
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{pending}/publish",
          "idempotencyKey": "privacy-request-0001",
          "saveBodyAs": "problemBody"
        },
        {
          "type": "assertNotMatches",
          "from": "successBody",
          "pattern": "studentId|sourceCode|modelApiKey|reviewEvidence"
        },
        {
          "type": "assertNotMatches",
          "from": "problemBody",
          "pattern": "studentId|sourceCode|modelApiKey|reviewEvidence"
        },
        {
          "type": "assertNotContains",
          "from": "successBody",
          "forbidden": ["contract-test-secret-that-is-at-least-32-bytes"]
        },
        {
          "type": "assertNotContains",
          "from": "problemBody",
          "forbidden": ["contract-test-secret-that-is-at-least-32-bytes"]
        }
      ]
    }
  ]
}
