      "steps": [
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{exact}/publish",
          "idempotencyKey": "exact-deadline-0001",
          "expected": {
            "status": 200,
            "contentType": "application/json",
            "body": {
              "labId": "{exact}",
              "status": "published",
              "publishedAt": "{instant}",
              "publishedBy": "ta-1"
            }
          }
        },
        { "type": "expectLab", "labId": "{exact}", "status": "published" }
      ]
    },
    {
      "name": "same-key-success-replays-different-key-gets-original-metadata",
      "labs": [
        {
          "id": "{owned}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{passed}"
        }
      ],
      "steps": [
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "success-request-0001",
          "saveBodyAs": "first",
          "expected": {
            "status": 200,
            "contentType": "application/json",
            "body": {
              "labId": "{owned}",
              "status": "published",
              "publishedAt": "{instant}",
              "publishedBy": "ta-1"
            }
          }
        },
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "success-request-0001",
          "expectedBodyEqualTo": "first"
