{
  "title": "LeeTKOB publication compatibility scenarios",
  "description": "Seed-and-expectation scenarios for the PA#2 publication contract, executed unchanged against the NestJS PA#2 application and the Go compatibility composition (apps/backend/internal/compatpub). Runners supply identical fixed clocks, synthetic identity tokens issued from the shared test secret, and in-memory adapters. Mirrors apps/api/test/contract/publish-lab.contract.test.ts; that suite remains the authoritative PA#2 assertion set. String placeholders: {owned}, {pending}, {foreign}, {absent}, {open}, {exact} resolve to lab UUIDs; {instant} to the fixed clock time; {passed} and {future} to the seeded deadlines.",
  "secret": "contract-test-secret-that-is-at-least-32-bytes",
  "nowSeconds": 1800000000,
  "instant": "2026-10-24T01:02:03.000Z",
  "identities": {
    "ta": { "subject": "ta-1", "role": "ta", "classIds": ["class-a"] },
    "student": { "subject": "student-1", "role": "student", "classIds": ["class-a"] }
  },
  "labs": {
    "owned": "0d0f366c-f9cf-45e8-bbf2-ab1b8e370ec8",
    "pending": "f6729f3d-d07e-497d-83fb-86a85810d84d",
    "foreign": "39cd4be5-103f-480c-a664-79b61bafabfa",
    "absent": "2a6c5486-63c7-48a6-9b30-9ab3a6f67c83",
    "open": "99d8b6db-4897-40a1-a153-b334f703612b",
    "exact": "c74d9158-c760-4a58-b1ca-402959d09469"
  },
  "deadlines": { "passed": "2026-10-23T22:00:00.000Z", "future": "2026-10-25T22:00:00.000Z" },
  "scenarios": [
    {
      "name": "successful-publication-returns-exact-safe-representation",
      "labs": [
        {
          "id": "{owned}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{passed}"
        }
      ],
      "steps": [
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "publish-request-0001",
          "expected": {
            "status": 200,
            "contentType": "application/json",
            "body": {
              "labId": "{owned}",
              "status": "published",
              "publishedAt": "{instant}",
              "publishedBy": "ta-1"
            }
          }
        },
        { "type": "expectLab", "labId": "{owned}", "status": "published" }
      ]
    },
    {
