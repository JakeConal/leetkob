# Judging worker image. It needs the libclang analyzer and a Docker daemon
# to create sandbox containers, so it carries clang/libclang itself.
FROM golang@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOOS=linux GOFLAGS=-mod=readonly GOTOOLCHAIN=local
COPY apps/backend/go.mod apps/backend/go.sum ./
COPY apps/backend/cmd ./cmd
COPY apps/backend/internal ./internal
COPY apps/backend/db ./db
RUN go build -o /worker ./cmd/worker

FROM debian@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates clang libclang-dev libstdc++-14-dev \
    && rm -rf /var/lib/apt/lists/*
COPY native/cpp-analyzer/analyzer.c /tmp/analyzer.c
RUN LIBDIR="$(dirname "$(clang -print-file-name=libclang.so)")" \
    && clang -std=c11 -D_XOPEN_SOURCE=700 /tmp/analyzer.c -o /usr/local/bin/cpp-analyzer \
        -L"$LIBDIR" -lclang -Wl,-rpath,"$LIBDIR" \
    && rm /tmp/analyzer.c
COPY --from=build /worker /usr/local/bin/worker
ENV CHECKER_ANALYZER=/usr/local/bin/cpp-analyzer
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/worker"]
