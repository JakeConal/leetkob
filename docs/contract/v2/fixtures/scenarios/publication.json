    {
      "id": "publication.success-at-deadline",
      "operationId": "publishLab",
      "decision": "D02",
      "covers": ["lab-publishing/Durable atomic grade visibility"],
      "effects": [
        "Publication metadata, every roster member's grade version 1, deductions, the audit event, the stored replay response, and notification intents commit in one transaction.",
        "Students without a submission and students with non-Accepted work have grade 0.00."
      ],
      "given": {
        "now": "2026-11-25T15:00:00.000Z",
        "actor": "ta-assigned",
        "state": [
          "Server time equals the deadline. No admission lease is outstanding, the roster is frozen, every counted submission is non-Accepted or fully reviewed."
        ]
      },
      "request": {
        "method": "POST",
        "path": "/v2/labs/1ab00000-0000-4000-8000-000000000003/publish",
        "headers": {
          "Cookie": "__Host-lk_access=<access:ta-assigned>",
          "X-CSRF-Token": "csrf-token-0123456789abcdef0123456789abcdef",
          "Idempotency-Key": "publish-0001-aaaa"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "labId": "1ab00000-0000-4000-8000-000000000003",
          "status": "published",
          "publishedAt": "2026-11-25T15:00:00.000Z",
          "publishedBy": "7a000000-0000-4000-8000-000000000001"
        }
      }
    },
