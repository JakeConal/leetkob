  "executionPolicy": {
    "decision": ["D01", "D04"],
    "rule": "cpuTimeLimitMs is 1000..5000 in whole seconds; wallTimeLimitMs = 3 * cpuTimeLimitMs; memoryLimitBytes is 64..512 MiB in whole mebibytes (1 MiB = 1,048,576 bytes); every other limit is fixed.",
    "fixed": {
      "sourceLimitBytes": 65536,
      "compileTimeLimitMs": 10000,
      "processLimit": 16,
      "outputLimitBytes": 1048576
    },
    "defaults": { "cpuTimeLimitMs": 1000, "memoryLimitBytes": 268435456 },
    "cases": [
      {
        "cpuTimeLimitMs": 1000,
        "memoryLimitBytes": 268435456,
        "valid": true,
        "wallTimeLimitMs": 3000
      },
      {
        "cpuTimeLimitMs": 2000,
        "memoryLimitBytes": 536870912,
        "valid": true,
        "wallTimeLimitMs": 6000
      },
      {
        "cpuTimeLimitMs": 5000,
        "memoryLimitBytes": 67108864,
        "valid": true,
        "wallTimeLimitMs": 15000
      },
      { "cpuTimeLimitMs": 999, "memoryLimitBytes": 268435456, "valid": false },
      { "cpuTimeLimitMs": 0, "memoryLimitBytes": 268435456, "valid": false },
      { "cpuTimeLimitMs": 1500, "memoryLimitBytes": 268435456, "valid": false },
      { "cpuTimeLimitMs": 5001, "memoryLimitBytes": 268435456, "valid": false },
