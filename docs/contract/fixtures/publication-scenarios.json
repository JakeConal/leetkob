    {
      "name": "non-ta-rejection-replays-for-same-subject",
      "labs": [
        {
          "id": "{owned}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{passed}"
        }
      ],
      "steps": [
        {
          "type": "request",
          "identity": "student",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "student-request-0001",
          "saveBodyAs": "first",
          "expected": {
            "status": 403,
            "body": {
              "type": "https://leetkob.example/problems/ta-role-required",
              "title": "TA role required",
              "status": 403,
              "detail": "Only a teaching assistant may publish a lab.",
              "instance": "/labs/{owned}/publish"
            }
          }
        },
        {
          "type": "request",
          "identityRef": "promoted",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "student-request-0001",
          "expectedBodyEqualTo": "first"
        },
        { "type": "expectLab", "labId": "{owned}", "status": "ready" }
      ],
      "identities": {
        "promoted": { "subject": "student-1", "role": "ta", "classIds": ["class-a"] }
      }
    },
    {
      "name": "absent-and-cross-class-labs-are-indistinguishable",
      "labs": [
        {
          "id": "{owned}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{passed}"
        },
        {
          "id": "{foreign}",
          "classId": "class-b",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{passed}"
        }
      ],
      "steps": [
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{absent}/publish",
          "idempotencyKey": "absent-request-0001",
          "saveBodyAs": "absentBody",
          "expected": {
            "status": 404,
            "body": {
              "type": "https://leetkob.example/problems/lab-not-found",
              "title": "Lab not found",
              "status": 404,
              "detail": "No lab is available to this teaching assistant at the requested identifier.",
              "instance": "/labs/{absent}/publish"
            }
          }
        },
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{foreign}/publish",
          "idempotencyKey": "foreign-request-0001",
          "saveBodyAs": "foreignBody",
          "expected": {
            "status": 404,
            "body": {
              "type": "https://leetkob.example/problems/lab-not-found",
              "title": "Lab not found",
              "status": 404,
              "detail": "No lab is available to this teaching assistant at the requested identifier.",
              "instance": "/labs/{foreign}/publish"
            }
          }
        },
        { "type": "assertNotContains", "from": "foreignBody", "forbidden": ["class-b"] }
      ]
    },
    {
      "name": "pending-review-rejection-replays-after-state-changes",
      "labs": [
        {
          "id": "{pending}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 2,
          "submissionDeadline": "{passed}"
        }
      ],
      "steps": [
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{pending}/publish",
          "idempotencyKey": "pending-request-0001",
          "saveBodyAs": "first",
          "expected": {
            "status": 409,
            "body": {
              "type": "https://leetkob.example/problems/reviews-pending",
              "title": "Reviews pending",
              "status": 409,
              "detail": "All required reviews must be resolved before marks can be published.",
              "instance": "/labs/{pending}/publish",
              "pendingReviews": 2
            }
          }
        },
        { "type": "expectLab", "labId": "{pending}", "status": "ready" },
        {
          "type": "saveLab",
          "lab": {
            "id": "{pending}",
            "classId": "class-a",
            "status": "ready",
            "pendingReviews": 0,
            "submissionDeadline": "{passed}"
          }
        },
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{pending}/publish",
          "idempotencyKey": "pending-request-0001",
          "expectedBodyEqualTo": "first"
        },
        { "type": "expectLab", "labId": "{pending}", "status": "ready" }
      ]
    },
    {
      "name": "deadline-gate-wins-before-reviews-and-replays-exactly",
      "labs": [
