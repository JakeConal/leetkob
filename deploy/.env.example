# Copy to deploy/.env and fill the values. Never commit deploy/.env.
# Synthetic values only; the assessment accounts are created with
# ASSESSMENT_PASSWORDS by cmd/provision (a one-time operator step).
POSTGRES_USER=leetkob
POSTGRES_PASSWORD=change-me-synthetic-32-chars-min
POSTGRES_DB=leetkob
POSTGRES_PORT=5432
# Public origin the browser uses; must match the API's WEB_ORIGIN.
WEB_ORIGIN=https://leetkob.example
WEB_PORT=3000
API_PORT=8080
# Numeric group from: stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
# Public DNS label assigned to the Azure public IP; no domain purchase.
PUBLIC_HOST=replace-with-azure-hostname
# Synthetic demo credentials only. Keep the completed file outside the source.
ASSESSMENT_PASSWORDS={"Admin":"replace-synthetic-password","TeachingAssistantA":"replace-synthetic-password","TeachingAssistantB":"replace-synthetic-password","StudentA1":"replace-synthetic-password","StudentA2":"replace-synthetic-password"}
