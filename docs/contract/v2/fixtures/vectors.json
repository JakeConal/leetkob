      },
      {
        "id": "accepted-without-violation",
        "judgeVerdict": "AC",
        "deductions": [],
        "steps": [],
        "expected": [{ "formulaGrade": "10.00", "manualAdjustmentAmount": null, "grade": "10.00" }]
      },
      {
        "id": "counted-wrong-answer-is-zero",
        "judgeVerdict": "WA",
        "deductions": [],
        "steps": [],
        "expected": [{ "formulaGrade": "0.00", "manualAdjustmentAmount": null, "grade": "0.00" }]
      },
      {
        "id": "no-submission-is-zero",
        "judgeVerdict": null,
        "deductions": [],
        "steps": [],
        "expected": [{ "formulaGrade": "0.00", "manualAdjustmentAmount": null, "grade": "0.00" }]
      },
      {
        "id": "positive-adjustment-then-accepted-appeal-clamps-at-ten",
        "judgeVerdict": "AC",
        "deductions": [
          { "key": "C1", "amount": "3.00", "evidenceLines": 2 },
          { "key": "C2", "amount": "4.00", "evidenceLines": 1 }
        ],
        "steps": [
          { "op": "adjust", "targetGrade": "8.50" },
          { "op": "appeal-accepted", "key": "C1" }
