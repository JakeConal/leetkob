          }
        },
        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{open}/publish",
          "idempotencyKey": "deadline-request-0001",
          "expectedBodyEqualTo": "first"
        },
        { "type": "expectLab", "labId": "{open}", "status": "ready" }
      ]
    },
    {
      "name": "publication-succeeds-when-server-time-equals-the-deadline",
      "labs": [
        {
          "id": "{exact}",
          "classId": "class-a",
          "status": "ready",
          "pendingReviews": 0,
          "submissionDeadline": "{instant}"
