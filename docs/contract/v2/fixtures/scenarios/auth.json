{
  "family": "auth",
  "scenarios": [
    {
      "id": "auth.register.created",
      "operationId": "registerAccount",
      "covers": ["identity-and-classes/Account and session lifecycle"],
      "effects": [
        "One student account exists; the password and refresh token are stored only as hashes.",
        "No token appears in the response body."
      ],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "anonymous",
        "state": ["No account uses student.one@example.edu."]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/register",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "student.one@example.edu",
          "password": "correct horse battery staple",
          "displayName": "Student One"
        }
      },
      "response": {
        "status": 201,
        "contentType": "application/json",
        "headers": {
          "Set-Cookie": [
            "__Host-lk_access=<access>; Path=/; Secure; HttpOnly; SameSite=Lax; Max-Age=900",
            "__Secure-lk_refresh=<refresh>; Path=/v2/auth; Secure; HttpOnly; SameSite=Strict; Max-Age=604800"
          ]
        },
        "body": {
          "user": {
            "id": "57000000-0000-4000-8000-000000000001",
            "email": "student.one@example.edu",
            "displayName": "Student One",
            "role": "student",
            "revision": 1
          },
          "csrfToken": "csrf-token-0123456789abcdef0123456789abcdef",
          "accessExpiresAt": "2026-11-12T01:15:00.000Z",
          "sessionExpiresAt": "2026-11-19T01:00:00.000Z"
        }
      }
    },
    {
      "id": "auth.register.role-member-rejected",
      "operationId": "registerAccount",
      "requestSchemaValid": false,
      "covers": ["identity-and-classes/Account and session lifecycle"],
      "effects": ["No account is created; a caller cannot select an elevated role."],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "anonymous",
        "state": ["No account uses ta.wannabe@example.edu."]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/register",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "student.one@example.edu",
          "password": "correct horse battery staple",
          "displayName": "Student One",
          "role": "ta"
        }
      },
      "response": {
        "status": 400,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/invalid-request",
          "title": "Invalid request",
          "status": 400,
          "detail": "The request does not satisfy the documented input rules.",
          "instance": "/v2/auth/register",
          "errors": [
            {
              "in": "body",
              "name": "/role",
              "code": "unknown-member"
            }
          ]
        }
      }
    },
    {
      "id": "auth.register.rejected",
      "operationId": "registerAccount",
      "effects": ["The existing account, its password, and its sessions are unchanged."],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "anonymous",
        "state": ["An account already uses student.one@example.edu."]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/register",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "student.one@example.edu",
          "password": "correct horse battery staple",
          "displayName": "Student One"
        }
      },
      "response": {
        "status": 409,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/registration-rejected",
          "title": "Registration rejected",
          "status": 409,
          "detail": "Registration could not be completed with these details.",
          "instance": "/v2/auth/register"
        }
      }
    },
    {
      "id": "auth.login.ok",
      "operationId": "logIn",
      "effects": ["Email comparison is case-insensitive; the response returns it lowercased."],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "anonymous",
        "state": ["student.one@example.edu exists with this password."]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/login",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "Student.One@Example.edu",
          "password": "correct horse battery staple"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "user": {
            "id": "57000000-0000-4000-8000-000000000001",
            "email": "student.one@example.edu",
            "displayName": "Student One",
            "role": "student",
            "revision": 1
          },
          "csrfToken": "csrf-token-0123456789abcdef0123456789abcdef",
          "accessExpiresAt": "2026-11-12T01:15:00.000Z",
          "sessionExpiresAt": "2026-11-19T01:00:00.000Z"
        }
      }
    },
    {
      "id": "auth.login.invalid-credentials",
      "operationId": "logIn",
      "covers": ["identity-and-classes/Authentication abuse controls"],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "anonymous",
        "state": [
          "Either no account uses this email or the password is wrong. Both cases return this exact body."
        ]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/login",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "nobody@example.edu",
          "password": "not the password"
        }
      },
      "response": {
        "status": 401,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/invalid-credentials",
          "title": "Invalid credentials",
          "status": 401,
          "detail": "The email or password is incorrect.",
          "instance": "/v2/auth/login"
        }
      }
    },
    {
      "id": "auth.login.rate-limited",
      "operationId": "logIn",
      "covers": ["identity-and-classes/Authentication abuse controls"],
      "effects": ["The response is identical whether or not the account exists."],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "anonymous",
        "state": ["The documented login attempt limit for this client and email is exhausted."]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/login",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "email": "student.one@example.edu",
          "password": "not the password"
        }
      },
      "response": {
        "status": 429,
        "contentType": "application/problem+json",
        "headers": {
          "Retry-After": "60"
        },
        "body": {
          "type": "https://leetkob.example/problems/rate-limited",
          "title": "Too many requests",
          "status": 429,
          "detail": "Too many attempts. Try again later.",
          "instance": "/v2/auth/login",
          "retryAfterSeconds": 60
        }
      }
    },
    {
      "id": "auth.login.unsupported-media-type",
      "operationId": "logIn",
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "anonymous",
        "state": []
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/login",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "bodyText": "email=student.one%40example.edu&password=x"
      },
      "response": {
        "status": 415,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/unsupported-media-type",
          "title": "Unsupported media type",
          "status": 415,
          "detail": "The request content type is not supported by this operation.",
          "instance": "/v2/auth/login"
        }
      }
    },
    {
      "id": "auth.refresh.rotated",
      "operationId": "refreshSession",
      "effects": [
        "The presented refresh token is consumed and a new one is set.",
        "sessionExpiresAt does not move: rotation never extends the session family."
      ],
      "given": {
        "now": "2026-11-12T01:14:00.000Z",
        "actor": "student-enrolled",
        "state": ["The refresh cookie holds the current unconsumed token."]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/refresh",
        "headers": {
          "Cookie": "__Secure-lk_refresh=<refresh:current>"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "user": {
            "id": "57000000-0000-4000-8000-000000000001",
            "email": "student.one@example.edu",
            "displayName": "Student One",
            "role": "student",
            "revision": 1
          },
          "csrfToken": "csrf-token-0123456789abcdef0123456789abcdef",
          "accessExpiresAt": "2026-11-12T01:29:00.000Z",
          "sessionExpiresAt": "2026-11-19T01:00:00.000Z"
        }
      }
    },
    {
      "id": "auth.refresh.reuse-detected",
      "operationId": "refreshSession",
      "covers": ["identity-and-classes/Account and session lifecycle"],
      "effects": ["The whole session family is revoked, including its newest refresh token."],
      "given": {
        "now": "2026-11-12T01:20:00.000Z",
        "actor": "student-enrolled",
        "state": ["The refresh cookie holds a token that was already consumed."]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/refresh",
        "headers": {
          "Cookie": "__Secure-lk_refresh=<refresh:consumed>"
        }
      },
      "response": {
        "status": 401,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/authentication-required",
          "title": "Authentication required",
          "status": 401,
          "detail": "A valid session is required.",
          "instance": "/v2/auth/refresh"
        }
      }
    },
    {
      "id": "auth.logout.ok",
      "operationId": "logOut",
      "effects": ["The session family is revoked and both cookies are cleared."],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "student-enrolled",
        "state": []
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/logout",
        "headers": {
          "Cookie": "__Host-lk_access=<access:student-enrolled>",
          "X-CSRF-Token": "csrf-token-0123456789abcdef0123456789abcdef"
        }
      },
      "response": {
        "status": 204,
        "contentType": null,
        "body": null
      }
    },
    {
      "id": "auth.logout.csrf-rejected",
      "operationId": "logOut",
      "covers": ["identity-and-classes/Authentication abuse controls"],
      "effects": ["The session stays valid."],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "student-enrolled",
        "state": ["The request carries the session cookie but no X-CSRF-Token."]
      },
      "request": {
        "method": "POST",
        "path": "/v2/auth/logout",
        "headers": {
          "Cookie": "__Host-lk_access=<access:student-enrolled>"
        }
      },
      "response": {
        "status": 403,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/csrf-rejected",
          "title": "Cross-site request rejected",
          "status": 403,
          "detail": "The request did not carry a valid origin and CSRF token.",
          "instance": "/v2/auth/logout"
        }
      }
    },
    {
      "id": "auth.session.ok",
      "operationId": "getSession",
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "ta-assigned",
        "state": []
      },
      "request": {
        "method": "GET",
        "path": "/v2/auth/session",
        "headers": {
          "Cookie": "__Host-lk_access=<access:ta-assigned>"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "user": {
            "id": "7a000000-0000-4000-8000-000000000001",
            "email": "ta.one@example.edu",
            "displayName": "TA One",
            "role": "ta",
            "revision": 2
          },
          "csrfToken": "csrf-token-0123456789abcdef0123456789abcdef",
          "accessExpiresAt": "2026-11-12T01:15:00.000Z",
          "sessionExpiresAt": "2026-11-19T01:00:00.000Z"
        }
      }
    },
    {
      "id": "auth.session.unauthenticated",
      "operationId": "getSession",
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "anonymous",
        "state": [
          "Missing, malformed, tampered, expired, and revoked sessions all return this body."
        ]
      },
      "request": {
        "method": "GET",
        "path": "/v2/auth/session",
        "headers": {}
      },
      "response": {
        "status": 401,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/authentication-required",
          "title": "Authentication required",
          "status": 401,
          "detail": "A valid session is required.",
          "instance": "/v2/auth/session"
        }
      }
    },
    {
      "id": "auth.users.lookup",
      "operationId": "findUserByEmail",
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "admin",
        "state": []
      },
      "request": {
        "method": "GET",
        "path": "/v2/auth/users?email=ta.one%40example.edu",
        "headers": {
          "Cookie": "__Host-lk_access=<access:admin>"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "id": "7a000000-0000-4000-8000-000000000001",
          "email": "ta.one@example.edu",
          "displayName": "TA One",
          "role": "student",
          "revision": 1
        }
      }
    },
    {
      "id": "auth.users.lookup.not-admin",
      "operationId": "findUserByEmail",
      "covers": ["identity-and-classes/Verified and current authorization"],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "ta-assigned",
        "state": ["The caller sends X-Role: admin; the header is ignored."]
      },
      "request": {
        "method": "GET",
        "path": "/v2/auth/users?email=ta.one%40example.edu",
        "headers": {
          "Cookie": "__Host-lk_access=<access:ta-assigned>",
          "X-Role": "admin"
        }
      },
      "response": {
        "status": 403,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/admin-role-required",
          "title": "Administrator role required",
          "status": 403,
          "detail": "This operation requires the administrator role.",
          "instance": "/v2/auth/users"
        }
      }
    },
    {
      "id": "auth.users.lookup.not-found",
      "operationId": "findUserByEmail",
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "admin",
        "state": []
      },
      "request": {
        "method": "GET",
        "path": "/v2/auth/users?email=nobody%40example.edu",
        "headers": {
          "Cookie": "__Host-lk_access=<access:admin>"
        }
      },
      "response": {
        "status": 404,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/user-not-found",
          "title": "User not found",
          "status": 404,
          "detail": "No such user is available.",
          "instance": "/v2/auth/users"
        }
      }
    },
    {
      "id": "auth.role.set",
      "operationId": "setUserRole",
      "effects": ["An audit event records the administrator, the old role, and the new role."],
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "admin",
        "state": ["The account is a student with no enrollments, at revision 1."]
      },
      "request": {
        "method": "PUT",
        "path": "/v2/auth/users/7a000000-0000-4000-8000-000000000001/role",
        "headers": {
          "Cookie": "__Host-lk_access=<access:admin>",
          "X-CSRF-Token": "csrf-token-0123456789abcdef0123456789abcdef",
          "Content-Type": "application/json"
        },
        "body": {
          "expectedRevision": 1,
          "role": "ta"
        }
      },
      "response": {
        "status": 200,
        "contentType": "application/json",
        "body": {
          "id": "7a000000-0000-4000-8000-000000000001",
          "email": "ta.one@example.edu",
          "displayName": "TA One",
          "role": "ta",
          "revision": 2
        }
      }
    },
    {
      "id": "auth.role.stale",
      "operationId": "setUserRole",
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "admin",
        "state": ["The account is already at revision 2."]
      },
      "request": {
        "method": "PUT",
        "path": "/v2/auth/users/7a000000-0000-4000-8000-000000000001/role",
        "headers": {
          "Cookie": "__Host-lk_access=<access:admin>",
          "X-CSRF-Token": "csrf-token-0123456789abcdef0123456789abcdef",
          "Content-Type": "application/json"
        },
        "body": {
          "expectedRevision": 1,
          "role": "ta"
        }
      },
      "response": {
        "status": 409,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/revision-conflict",
          "title": "Revision conflict",
          "status": 409,
          "detail": "The resource changed after it was read. Refresh and try again.",
          "instance": "/v2/auth/users/7a000000-0000-4000-8000-000000000001/role",
          "conflicts": [
            {
              "resource": "user",
              "id": "7a000000-0000-4000-8000-000000000001",
              "currentRevision": 2
            }
          ]
        }
      }
    },
    {
      "id": "auth.role.not-allowed",
      "operationId": "setUserRole",
      "given": {
        "now": "2026-11-12T01:00:00.000Z",
        "actor": "admin",
        "state": ["The TA account is still assigned to a class."]
      },
      "request": {
        "method": "PUT",
        "path": "/v2/auth/users/7a000000-0000-4000-8000-000000000001/role",
        "headers": {
          "Cookie": "__Host-lk_access=<access:admin>",
          "X-CSRF-Token": "csrf-token-0123456789abcdef0123456789abcdef",
          "Content-Type": "application/json"
        },
        "body": {
          "expectedRevision": 2,
          "role": "student"
        }
      },
      "response": {
        "status": 409,
        "contentType": "application/problem+json",
        "body": {
          "type": "https://leetkob.example/problems/role-change-not-allowed",
          "title": "Role change not allowed",
          "status": 409,
          "detail": "The role cannot be changed while the account holds conflicting memberships.",
          "instance": "/v2/auth/users/7a000000-0000-4000-8000-000000000001/role"
        }
      }
    }
  ]
}
