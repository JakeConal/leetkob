# Copy to deploy/.env and fill the values. Never commit deploy/.env.
# Synthetic values only; the assessment accounts are created with
# ASSESSMENT_PASSWORDS by cmd/provision (a one-time operator step).
POSTGRES_USER=leetkob
POSTGRES_PASSWORD=change-me-synthetic-32-chars-min
POSTGRES_DB=leetkob
POSTGRES_PORT=5432
# Public origin the browser uses; must match the API's WEB_ORIGIN.
WEB_ORIGIN=https://leetkob.example
WEB_PORT=3000
API_PORT=8080
# Worker host work root; must be identical inside and outside the container.
WORK_ROOT=/srv/leetkob-work
