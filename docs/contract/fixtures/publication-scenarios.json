        {
          "type": "request",
          "identity": "ta",
          "method": "POST",
          "path": "/labs/{owned}/publish",
          "idempotencyKey": "success-request-0002",
          "expected": {
            "status": 409,
            "body": {
              "type": "https://leetkob.example/problems/lab-already-published",
